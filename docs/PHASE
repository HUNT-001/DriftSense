### 3. Interface contract (committed first, Oct 11)

Person B imports only `driftsense.api.localize` and the models in `driftsense.contracts`. The engine is chosen with `DRIFTSENSE_ENGINE=fake|v1|v2`. Until G2 the default is `v1`. A one-line PR at G2 flips the default to `v2`. `driftsense.v2.localize` exists, as the plan agreed, and is re-exported from `driftsense/v2/__init__.py`.

**`driftsense/contracts.py`**
```python
"""DriftSense public contracts. CHANGING THIS FILE REQUIRES A shared/* BRANCH AND BOTH APPROVALS.
Bump CONTRACT_VERSION (semver) on any change; minor = additive optional fields only."""
from __future__ import annotations

import json
from datetime import datetime
from enum import Enum
from pathlib import Path
from typing import Literal, Optional

from pydantic import BaseModel, ConfigDict, Field, model_validator

CONTRACT_VERSION = "1.0.0"


class DriftSenseInputError(ValueError):
    """Raised for undecodable images, template larger than search, empty input."""


class _Model(BaseModel):
    model_config = ConfigDict(frozen=True, extra="forbid")


class Mode(str, Enum):
    FAST = "fast"          # lattice + roughness, no cascade
    ACCURATE = "accurate"  # full pipeline incl. subpixel
    DENSE = "dense"        # dense candidate scan (recall@20 path)
    AUTO = "auto"          # engine decides (cascade if margin low)


class Budget(_Model):
    max_ms: int = Field(2000, ge=1, description="Soft wall-clock budget for one localize call")
    max_candidates: int = Field(20, ge=1, le=200)
    tau: Optional[float] = Field(None, description="Override calibrated uniqueness-margin threshold; None = calibrated")


class LatticeType(str, Enum):
    FINFET = "finfet"; DRAM = "dram"; GRID = "grid"; STAGGERED = "staggered"; UNKNOWN = "unknown"


class Offset(_Model):
    """Template top-left location in search-image coordinates (x right, y down), subpixel."""
    x_px: float
    y_px: float
    x_nm: Optional[float] = None
    y_nm: Optional[float] = None
    pixel_size_nm: Optional[float] = None


class Candidate(_Model):
    rank: int = Field(..., ge=1)
    x_px: float
    y_px: float
    score: float = Field(..., description="Final fused score, higher is better")
    lattice_score: Optional[float] = None
    roughness_score: Optional[float] = None


class Margin(_Model):
    margin: float = Field(..., description="Calibrated uniqueness margin between rank-1 and rank-2")
    tau: float
    calibrated: bool
    p_correct: Optional[float] = Field(None, ge=0, le=1)
    decision: Literal["commit", "escalate"]

    @model_validator(mode="after")
    def _decision_matches(self) -> "Margin":
        if (self.decision == "commit") != (self.margin >= self.tau):
            raise ValueError("decision must be 'commit' iff margin >= tau")
        return self


class StageTiming(_Model):
    stage: str = Field(..., description="e.g. ingest, lattice, rectify, roughness, score, cascade, contour, confidence, subpixel, explain")
    ms: float = Field(..., ge=0)


class Artifact(_Model):
    kind: Literal["heatmap", "overlay", "contour", "candidates", "json"]
    uri: str = Field(..., description="Relative path locally, s3:// key in service")
    sha256: Optional[str] = None


class LocalizeResult(_Model):
    contract_version: str = CONTRACT_VERSION
    engine: Literal["fake", "v1", "v2"]
    engine_version: str
    mode: Mode
    lattice_type: LatticeType = LatticeType.UNKNOWN
    offset: Offset
    candidates: list[Candidate] = Field(..., min_length=1)
    margin: Margin
    timings: list[StageTiming] = Field(default_factory=list)
    total_ms: float = Field(..., ge=0)
    artifacts: list[Artifact] = Field(default_factory=list)
    warnings: list[str] = Field(default_factory=list)

    @model_validator(mode="after")
    def _ranks(self) -> "LocalizeResult":
        if [c.rank for c in self.candidates] != list(range(1, len(self.candidates) + 1)):
            raise ValueError("candidate ranks must be 1..n in order")
        return self


# ---------- Agent trace (one JSON object per line, file: traces/<run_id>.jsonl) ----------
class TraceEvent(_Model):
    v: Literal["1"] = "1"
    run_id: str
    step: int = Field(..., ge=0)
    ts: datetime
    kind: Literal["observe", "tool_call", "tool_result", "decision", "commit_move",
                  "escalate", "human_approval", "error", "episode_end"]
    tool: Optional[str] = None                      # e.g. "sem.acquire", "driftsense.localize", "stage.move"
    args: dict = Field(default_factory=dict)
    result_summary: dict = Field(default_factory=dict)
    margin: Optional[float] = None
    tau: Optional[float] = None
    because: Optional[str] = Field(None, description="Human-readable reason, e.g. 'margin 0.31 >= tau 0.22'")
    stage_move_nm: Optional[tuple[float, float]] = None
    latency_ms: Optional[float] = None
    policy: Optional[Literal["rules", "llm"]] = None


# ---------- Service job API ----------
class JobCreate(_Model):
    demo_id: Optional[str] = None
    template_key: Optional[str] = None
    search_key: Optional[str] = None
    mode: Mode = Mode.AUTO
    budget: Budget = Budget()
    agent: bool = False
    client_token: Optional[str] = Field(None, description="Idempotency key")

    @model_validator(mode="after")
    def _source(self) -> "JobCreate":
        if not self.demo_id and not (self.template_key and self.search_key):
            raise ValueError("provide demo_id or both template_key and search_key")
        return self


class WorkerInfo(_Model):
    instance_type: Optional[str] = None
    arch: Literal["x86_64", "aarch64", "arm64", "unknown"] = "unknown"
    opencv_version: str
    numpy_version: str
    cool: bool = False


class ApprovalRequest(_Model):
    options: list[Candidate] = Field(..., min_length=1, max_length=3)
    margin: Margin


class ApprovalDecision(_Model):
    chosen_rank: Optional[int] = Field(None, ge=1, le=3, description="None = reject all")
    approver: str
    note: Optional[str] = None


class ErrorInfo(_Model):
    code: str
    message: str


class JobStatus(_Model):
    job_id: str
    status: Literal["queued", "running", "awaiting_approval", "succeeded", "failed"]
    created_at: datetime
    updated_at: datetime
    engine: Optional[Literal["fake", "v1", "v2"]] = None
    result: Optional[LocalizeResult] = None
    trace_key: Optional[str] = None
    approval: Optional[ApprovalRequest] = None
    error: Optional[ErrorInfo] = None
    worker: Optional[WorkerInfo] = None


# ---------- results/*.json ----------
class EnvInfo(_Model):
    python: str
    opencv: str
    numpy: str
    platform: str
    arch: str
    instance_type: Optional[str] = None
    cool: bool = False


class Metric(_Model):
    value: float
    unit: str
    ci_low: Optional[float] = None
    ci_high: Optional[float] = None
    n: Optional[int] = None


class ResultsFile(_Model):
    schema_id: Literal["driftsense.results/1"] = "driftsense.results/1"
    name: str
    produced_by: str = Field(..., description="Script path that generated this file")
    git_sha: str
    created_at: datetime
    dataset: Literal["dev", "sealed", "synthetic", "bench"]
    env: EnvInfo
    metrics: dict[str, Metric]
    protocol_sha256: Optional[str] = None


SCHEMAS = {
    "localize_result": LocalizeResult, "trace_event": TraceEvent, "job_create": JobCreate,
    "job_status": JobStatus, "approval_decision": ApprovalDecision, "results_file": ResultsFile,
}


def export_schemas(out_dir: Path) -> None:
    out_dir.mkdir(parents=True, exist_ok=True)
    for name, model in SCHEMAS.items():
        (out_dir / f"{name}.schema.json").write_text(
            json.dumps(model.model_json_schema(), indent=2, sort_keys=True) + "\n")
```

**`driftsense/api.py`** (the stable facade)
```python
from __future__ import annotations
import importlib, os
from driftsense.contracts import Budget, LocalizeResult, Mode

_ENGINES = {
    "fake": "driftsense.engines.fake:localize",
    "v1": "driftsense.engines.v1_adapter:localize",
    "v2": "driftsense.v2.engine:localize",
}
DEFAULT_ENGINE = "v1"   # flipped to "v2" by A in int/g2-default-v2 after g2-pass


def available_engines() -> list[str]:
    out = []
    for name, target in _ENGINES.items():
        try:
            importlib.import_module(target.split(":")[0]); out.append(name)
        except Exception:
            pass
    return out


def localize(template_bytes: bytes, search_bytes: bytes, mode: Mode = Mode.AUTO,
             budget: Budget | None = None, *, engine: str | None = None) -> LocalizeResult:
    name = engine or os.environ.get("DRIFTSENSE_ENGINE", DEFAULT_ENGINE)
    if name not in _ENGINES:
        raise ValueError(f"unknown engine {name!r}; choose from {sorted(_ENGINES)}")
    mod, fn = _ENGINES[name].split(":")
    return getattr(importlib.import_module(mod), fn)(template_bytes, search_bytes, mode, budget or Budget())
```

**`driftsense/engines/fake.py`** (deterministic, fast and actually correct on easy pairs, so B's demos look real)
```python
from __future__ import annotations
import time
import cv2
import numpy as np
from driftsense.contracts import (Budget, Candidate, DriftSenseInputError, LocalizeResult, Margin,
                                  Mode, Offset, StageTiming)

def _decode(b: bytes, name: str) -> np.ndarray:
    if not b:
        raise DriftSenseInputError(f"{name}: empty")
    img = cv2.imdecode(np.frombuffer(b, np.uint8), cv2.IMREAD_GRAYSCALE)
    if img is None:
        raise DriftSenseInputError(f"{name}: not a decodable image")
    return img

def localize(template_bytes: bytes, search_bytes: bytes, mode: Mode, budget: Budget) -> LocalizeResult:
    t0 = time.perf_counter()
    T, S = _decode(template_bytes, "template"), _decode(search_bytes, "search")
    if T.shape[0] > S.shape[0] or T.shape[1] > S.shape[1]:
        raise DriftSenseInputError("template larger than search")
    t1 = time.perf_counter()
    R = cv2.matchTemplate(S, T, cv2.TM_CCOEFF_NORMED)
    h, w = T.shape
    cands = []
    for k in range(min(budget.max_candidates, 5)):
        _, mx, _, (x, y) = cv2.minMaxLoc(R)
        cands.append(Candidate(rank=k + 1, x_px=float(x), y_px=float(y), score=float(mx)))
        R[max(0, y - h // 2): y + h // 2 + 1, max(0, x - w // 2): x + w // 2 + 1] = -1.0
    t2 = time.perf_counter()
    m = cands[0].score - (cands[1].score if len(cands) > 1 else -1.0)
    tau = budget.tau if budget.tau is not None else 0.10
    return LocalizeResult(
        engine="fake", engine_version="fake-1", mode=mode,
        offset=Offset(x_px=cands[0].x_px, y_px=cands[0].y_px), candidates=cands,
        margin=Margin(margin=m, tau=tau, calibrated=False, decision="commit" if m >= tau else "escalate"),
        timings=[StageTiming(stage="ingest", ms=(t1 - t0) * 1e3), StageTiming(stage="score", ms=(t2 - t1) * 1e3)],
        total_ms=(t2 - t0) * 1e3, warnings=["fake engine: not for reported numbers"])
```
`driftsense/engines/v1_adapter.py` wraps the frozen v1 entry point and maps its output into `LocalizeResult` (`engine="v1"`, `calibrated=False`). Its body depends on v1's actual return type, so Prompt S4 has Claude write it. `driftsense/v2/engine.py` starts as a stub that raises `NotImplementedError`; `available_engines()` only reports what imports cleanly.

**`tests/contract/test_contracts.py`**
```python
import json, pathlib
import cv2, numpy as np, pytest
from driftsense.api import available_engines, localize
from driftsense.contracts import (CONTRACT_VERSION, Budget, DriftSenseInputError, JobCreate, JobStatus,
                                  LocalizeResult, Margin, Mode, TraceEvent, export_schemas)

ROOT = pathlib.Path(__file__).resolve().parents[2]

def _png(a):
    ok, buf = cv2.imencode(".png", a); assert ok; return buf.tobytes()

@pytest.fixture
def pair():
    rng = np.random.default_rng(0)
    s = (rng.random((256, 256)) * 255).astype(np.uint8)
    return _png(s[64:128, 80:144].copy()), _png(s)

def test_committed_schemas_match_models(tmp_path):
    export_schemas(tmp_path)
    for f in sorted(tmp_path.glob("*.schema.json")):
        committed = ROOT / "contracts" / f.name
        assert committed.exists(), f"missing {committed}: run `make contracts`"
        assert json.loads(committed.read_text()) == json.loads(f.read_text()), \
            f"{f.name} drifted: run `make contracts` on a shared/* branch and get both approvals"

@pytest.mark.parametrize("engine", ["fake", "v1", "v2"])
def test_engine_honours_contract(engine, pair, monkeypatch):
    if engine not in available_engines():
        pytest.skip(f"{engine} not importable yet")
    monkeypatch.setenv("DRIFTSENSE_ENGINE", engine)
    try:
        r = localize(*pair, mode=Mode.AUTO, budget=Budget())
    except NotImplementedError:
        pytest.skip(f"{engine} still a stub")
    assert isinstance(r, LocalizeResult) and r.contract_version == CONTRACT_VERSION
    LocalizeResult.model_validate_json(r.model_dump_json())
    assert 1 <= len(r.candidates) <= Budget().max_candidates
    assert r.total_ms >= 0

def test_fake_is_deterministic_and_correct(pair):
    a = localize(*pair, engine="fake"); b = localize(*pair, engine="fake")
    assert a.offset == b.offset and (a.offset.x_px, a.offset.y_px) == (80.0, 64.0)

def test_bad_input_raises():
    with pytest.raises(DriftSenseInputError):
        localize(b"not an image", b"also not", engine="fake")

def test_margin_decision_invariant():
    with pytest.raises(ValueError):
        Margin(margin=0.1, tau=0.2, calibrated=True, decision="commit")

def test_trace_and_job_roundtrip(pair):
    r = localize(*pair, engine="fake")
    ev = TraceEvent(run_id="r1", step=0, ts="2026-10-11T00:00:00Z", kind="decision",
                    margin=r.margin.margin, tau=r.margin.tau, because="margin vs tau")
    assert TraceEvent.model_validate_json(ev.model_dump_json()) == ev
    js = JobStatus(job_id="j1", status="succeeded", created_at="2026-10-11T00:00:00Z",
                   updated_at="2026-10-11T00:00:01Z", engine="fake", result=r)
    assert JobStatus.model_validate_json(js.model_dump_json()).result == r
    with pytest.raises(ValueError):
        JobCreate()
```

**Rules for changing the contract:** it is additive only after Oct 13. Any change needs a `shared/contract-*` branch, a `CONTRACT_VERSION` bump, regenerated `contracts/*.schema.json` (`make contracts`) and both approvals. B's service must store `contract_version` with every job.

### 4. Day-by-day schedule (IST)

Daily ritual on both machines:
- **09:30** — 10-minute call. Each person runs `/sync`, states today's branch, and declares any shared-file change (which then goes first).
- **13:00** — shared-file window: `shared/*` PRs are reviewed and merged.
- **18:00** — every active branch has an open PR (a draft is fine).
- **21:00** — review the other person's PRs with `/review-pr`.
- **22:00** — merge what is approved and green.

No branch lives past 48 hours.

