    amdahl.<cmp>.<mode>.{predicted_speedup, upper_bound_speedup (-1 = unbounded)}
    arm.<arm>.census.<mode>.share.{kleidicv,control,non_cv2}      fraction
    arm.<arm>.e2e.<mode>.latency.tN.{median_ms,p95_ms}, .e2e.<mode>.throughput.per_hour
    arm.<arm>.stage.<mode>.total.t1.median_ms, arm.<arm>.agent.throughput.per_hour
