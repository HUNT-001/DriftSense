{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git fetch*)",
      "Bash(git switch*)", "Bash(git add *)", "Bash(git commit *)", "Bash(git rebase *)",
      "Bash(git push -u origin *)", "Bash(git push --force-with-lease*)", "Bash(git worktree *)",
      "Bash(gh pr *)", "Bash(gh run *)", "Bash(gh issue *)", "Bash(gh api repos/HUNT-001/DriftSense/*)",
      "Bash(python -m pytest*)", "Bash(pytest*)", "Bash(ruff *)", "Bash(python scripts/*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./eval/sealed/**)", "Read(./data/sealed/**)",
      "Bash(git push origin main*)", "Bash(git push --force *)", "Bash(cdk destroy*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-tests.sh", "timeout": 600 }
      ] },
      { "matcher": "Edit|Write|MultiEdit", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edit.sh" }
      ] }
    ]
  }
}
