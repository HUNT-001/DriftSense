{
  "name": "driftsense-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DriftSense Pilot static web UI (S3 + CloudFront)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "jsdom": "29.1.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
